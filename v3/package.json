{
  "name": "trayn-slipstream-v3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/render-pages.mjs --dev && vite --host 127.0.0.1",
    "build": "node scripts/render-pages.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node --check src/main.js && node --check src/templates.js && node --check src/site-paths.js && node --check scripts/render-pages.mjs && node --check scripts/verify-hosting.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:hosting:static": "node scripts/verify-hosting.mjs"
  },
  "dependencies": { "gsap": "^3.13.0" },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.55.0",
    "vite": "^7.1.0"
  }
}
