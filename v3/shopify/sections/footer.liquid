{% assign shop_collection = collections['trayn-whey-collection'] %}{% assign shop_destination = shop_collection.url | default: routes.all_products_collection_url %}
<footer class="study-footer"><a href="{{ routes.root_url }}" aria-label="TRAYN home"><img src="{{ 'trayn-logo-256.webp' | asset_url }}" width="740" height="440" alt="TRAYN Nutrition" loading="lazy"></a><p>© {{ 'now' | date: '%Y' }} {{ 'general.brand_name' | t | escape }}<br>Raise your standard.</p><nav aria-label="Shop, questions and store policies"><a href="{{ shop_destination }}">Shop all ↗</a><a href="{{ routes.root_url }}#questions">Questions ↗</a>{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</nav>{% assign contact_page = pages['contact'] %}{% if contact_page != blank %}<a href="{{ contact_page.url }}">Contact TRAYN ↗</a>{% else %}<a href="mailto:{{ shop.email | escape }}">Contact TRAYN ↗</a>{% endif %}</footer>
{% schema %}{"name":"Footer","settings":[]}{% endschema %}
