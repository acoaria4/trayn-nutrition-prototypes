{% render 'purchase-panel', purchase_product: product, section_id: section.id, is_main: true, shipping_note: section.settings.shipping_note, purchase_image: section.settings.purchase_image %}
{% if product.description contains '<!-- TRAYN product details -->' %}{% assign retail_details = product.description | split: '<!-- TRAYN product details -->' | last %}<section class="seo-product-details seo-detail section-shell" aria-label="Product information"><div class="rte">{{ retail_details }}</div></section>{% endif %}
{% capture json_lt_escape %}{% raw %}\u003c{% endraw %}{% endcapture %}<script type="application/ld+json">{{ product | structured_data | replace: '<', json_lt_escape }}</script>
{% capture approved_details %}{% for block in section.blocks %}{% if block.settings.approved and block.settings.product.id == product.id and block.settings.content != blank %}<div class="seo-detail" {{ block.shopify_attributes }}><h2>{{ block.settings.heading | default: 'Product information' | escape }}</h2><div class="rte">{{ block.settings.content }}</div></div>{% endif %}{% endfor %}{% endcapture %}
{% assign approved_details = approved_details | strip %}
{% if approved_details != blank %}<section class="seo-product-details section-shell" aria-label="Product information">{{ approved_details }}</section>{% endif %}
<nav class="seo-product-nav section-shell" aria-label="Product navigation"><a href="{{ routes.root_url }}">Home</a><a href="{{ routes.all_products_collection_url }}">Shop all products ↗</a>{% if shop.shipping_policy.body != blank %}<a href="{{ shop.shipping_policy.url }}">Shipping policy ↗</a>{% endif %}{% if shop.terms_of_service.body != blank %}<a href="{{ shop.terms_of_service.url }}">Terms of service ↗</a>{% endif %}</nav>
{% schema %}{"name":"Product purchase","settings":[{"type":"image_picker","id":"purchase_image","label":"Shop image","info":"Optional campaign image. Add approved product photography to the Shopify product media for product schema and the product gallery."},{"type":"textarea","id":"shipping_note","label":"Delivery information","info":"Use confirmed shipping information only."}],"blocks":[{"type":"approved_detail","name":"Approved product detail","settings":[{"type":"product","id":"product","label":"Product","info":"Required: this content appears only on the selected product's page."},{"type":"checkbox","id":"approved","label":"Content approved for sale","default":false,"info":"Enable only after the product facts and wording have been verified."},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"content","label":"Approved content","info":"Use for nutrition, ingredients/allergens, usage/storage or other approved product-specific information."}]}],"max_blocks":16}{% endschema %}
