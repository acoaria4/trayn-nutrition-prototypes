<header class="study-header" id="top">
<a href="{{ routes.root_url }}" aria-label="TRAYN home"><img src="{{ 'trayn-logo-256.webp' | asset_url }}" width="740" height="440" alt="TRAYN Nutrition"></a>
<nav class="desktop-navigation" aria-label="Main navigation">{% render 'navigation' %}</nav>
<div class="header-actions"><a href="{{ routes.cart_url }}" class="cart-link" data-cart-open aria-haspopup="dialog">Cart <span data-cart-count>{{ cart.item_count }}</span></a><details class="site-menu"><summary>Menu <span aria-hidden="true">+</span></summary><nav aria-label="Mobile navigation">{% render 'navigation' %}</nav></details></div>
</header>
{% schema %}{"name":"Header","settings":[]}{% endschema %}
