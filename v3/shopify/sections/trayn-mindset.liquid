 <section class="study-chapter chapter-mindset" id="mindset" tabindex="-1" aria-labelledby="study-mindset-heading">
  <p class="eyebrow"><span>03</span> / The TRAYN mindset</p>
  <div class="mindset-pin"><div class="mindset-depth" aria-hidden="true"><span class="mindset-brand"></span></div><div class="mindset-poster"><h2 id="study-mindset-heading"><span class="mindset-word mindset-get">GET</span><span class="mindset-word mindset-built">BUILT.</span></h2></div>
  </div>
  <div class="mindset-copy"><h3>{{ section.settings.heading | escape | newline_to_br }}</h3><div><p>{{ section.settings.body | escape | newline_to_br }}</p><a href="#packaging" class="study-link">Meet the pack <span aria-hidden="true">↓</span></a></div></div>
 </section>

{% schema %}
{
  "name": "TRAYN mindset",
  "tag": "div",
  "class": "trayn-section",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "For those who\nexpect more."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Discipline in your training. No compromise in your standards. Meet TRAYN Belgian Chocolate whey protein concentrate."
    }
  ],
  "presets": [
    {
      "name": "TRAYN mindset"
    }
  ]
}
{% endschema %}
