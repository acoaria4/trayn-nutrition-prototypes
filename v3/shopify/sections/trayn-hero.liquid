<section class="hero-story" aria-label="Fuel your potential">
 <div class="hero-pin"><div class="hero-scene">
  <img class="hero-foil" src="{{ 'tension-hero-1672.webp' | asset_url }}" srcset="{{ 'tension-hero-960.webp' | asset_url }} 960w, {{ 'tension-hero-1672.webp' | asset_url }} 1672w" sizes="100vw" width="1672" height="941" alt="" fetchpriority="high">
  <div class="hero-stream" aria-hidden="true"><img src="{{ 'hero-slipstream.svg' | asset_url }}" width="1440" height="900" alt="" decoding="async"></div>
  <div class="hero-opening"><p class="eyebrow"><span>01</span> / Premium whey protein</p><h1>{{ section.settings.heading | escape }}<br><span>{{ section.settings.accent | escape }}</span></h1><p class="hero-intro">{{ section.settings.intro | escape | newline_to_br }}</p></div><a href="#purchase" class="hero-scroll"><span>Shop Belgian Chocolate</span><span aria-hidden="true">↓</span></a>
  <div class="hero-product"><div class="hero-product-pose"><img class="pouch-image pouch-front"   src="{{ 'belgian-chocolate-wpc-front-retail.webp' | asset_url }}" width="1024" height="1536" alt="TRAYN Belgian Chocolate 500 g front pack" decoding="async" fetchpriority="high"><div class="hero-light" aria-hidden="true"></div></div></div>
  <article class="hero-flavour"><p class="eyebrow"><span>02</span> / The flavour</p><h2>BELGIAN<br>CHOCOLATE.</h2><p>Premium whey protein concentrate.</p><div class="hero-spec"><span>500 <small>g</small></span><span>Net quantity.<br>15 servings per pack.</span></div><a class="study-link" href="#purchase">Shop Belgian Chocolate <span aria-hidden="true">↗</span></a></article>
  <div class="hero-bottom"><span>Belgian Chocolate / WPC</span><div><i></i></div><span>Belgian Chocolate / TRAYN</span></div>
 </div></div>
</section>

{% schema %}
{
  "name": "TRAYN hero",
  "tag": "div",
  "class": "trayn-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FUEL YOUR"
    },
    {
      "type": "text",
      "id": "accent",
      "label": "Red heading",
      "default": "POTENTIAL."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "For those who expect more.\nNo compromise on quality."
    }
  ],
  "presets": [
    {
      "name": "TRAYN hero"
    }
  ]
}
{% endschema %}
