<section class="hero-story" aria-label="Fuel your potential">
 <div class="hero-pin"><div class="hero-scene">
  <img class="hero-foil" src="{{ 'tension-hero-1672.webp' | asset_url }}" srcset="{{ 'tension-hero-960.webp' | asset_url }} 960w, {{ 'tension-hero-1672.webp' | asset_url }} 1672w" sizes="100vw" width="1672" height="941" alt="" fetchpriority="high">
  <svg class="hero-stream" viewBox="0 0 1440 900" fill="none" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
<path d="M-180 985C420 940 1015 615 1570-240L1580-100C1045 710 455 1040-180 1050Z" fill="#f82030"/>
<path d="M-180 1070C500 1015 1110 705 1580-50L1585-8C1100 760 490 1050-180 1090Z" fill="#c8c4c0"/>
<path d="M-180 965C450 895 1050 560 1560-300" stroke="#f82030" stroke-width="3"/>
</svg>
  <div class="hero-opening"><p class="eyebrow"><span>01</span> / TRAYN Nutrition</p><h1>{{ section.settings.heading | escape }}<br><span>{{ section.settings.accent | escape }}</span></h1><p class="hero-intro">{{ section.settings.intro | escape | newline_to_br }}</p></div><a href="#purchase" class="hero-scroll"><span>Shop the Whey</span><span aria-hidden="true">↓</span></a>
  <div class="hero-product"><div class="hero-product-pose"><img class="pouch-image pouch-front"   src="{{ 'belgian-chocolate-wpc-1024.webp' | asset_url }}" width="1024" height="1536" alt="TRAYN Belgian Chocolate 500 g front pouch concept" decoding="async" fetchpriority="high"><div class="hero-light" aria-hidden="true"></div></div></div>
  <article class="hero-flavour"><p class="eyebrow"><span>02</span> / The flavour</p><h2>BELGIAN<br>CHOCOLATE.</h2><p>Whey protein concentrate.</p><div class="hero-spec"><span>500 <small>g</small></span><span>Net quantity,<br>as shown on the pack.</span></div><a class="study-link" href="#purchase">Shop the Whey <span aria-hidden="true">↗</span></a></article>
  <div class="hero-bottom"><span>Belgian Chocolate / WPC</span><div><i></i></div><span>Belgian Chocolate / TRAYN</span></div>
 </div></div>
</section>

{% schema %}
{
  "name": "TRAYN hero",
  "tag": "div",
  "class": "trayn-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FUEL YOUR"
    },
    {
      "type": "text",
      "id": "accent",
      "label": "Red heading",
      "default": "POTENTIAL."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "For the work you put in.\nAnd the person you’re building."
    }
  ],
  "presets": [
    {
      "name": "TRAYN hero"
    }
  ]
}
{% endschema %}
