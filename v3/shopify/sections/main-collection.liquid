<section class="section-shell"><nav class="seo-breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span aria-current="page">{{ collection.title | escape }}</span></nav><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}{% paginate collection.products by 12 %}<ul class="product-grid">{% for card_product in collection.products %}<li><a href="{{ card_product.url }}">{% if card_product.featured_image %}{{ card_product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '(min-width: 900px) 30vw, 45vw', alt: card_product.title }}{% else %}<div class="product-card-empty">{{ card_product.title | escape }}</div>{% endif %}<h2>{{ card_product.title | escape }}</h2><p>{{ card_product.price | money_with_currency }}{% unless card_product.available %} · Sold Out{% endunless %}</p></a></li>{% else %}<li>No products to display.</li>{% endfor %}</ul>{{ paginate | default_pagination }}{% endpaginate %}</section>
{% schema %}{"name":"Collection","settings":[]}{% endschema %}
