{% assign selected_product = section.settings.product | default: settings.featured_product %}
{% render 'purchase-panel', purchase_product: selected_product, section_id: section.id, is_main: false, shipping_note: section.settings.shipping_note, purchase_image: section.settings.purchase_image %}
{% schema %}{"name":"TRAYN featured product","settings":[{"type":"product","id":"product","label":"Product"},{"type":"image_picker","id":"purchase_image","label":"Shop image","info":"Optional image for this purchase area. Otherwise uses product media or the Belgian Chocolate artwork."},{"type":"textarea","id":"shipping_note","label":"Delivery information","info":"Enter confirmed shipping information. Leave blank until confirmed."}],"presets":[{"name":"TRAYN featured product"}]}{% endschema %}
