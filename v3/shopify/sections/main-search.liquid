<section class="simple-page section-shell"><h1>SEARCH TRAYN.</h1><form action="{{ routes.search_url }}" method="get" role="search"><label for="store-search">Search</label><input id="store-search" name="q" type="search" value="{{ search.terms | escape }}"><button type="submit" class="buy-button">Search ↗</button></form>{% if search.performed %}{% paginate search.results by 12 %}<ul>{% for result in search.results %}<li><a href="{{ result.url }}">{{ result.title | escape }}</a></li>{% else %}<li>No results found.</li>{% endfor %}</ul>{{ paginate | default_pagination }}{% endpaginate %}{% endif %}</section>
{% schema %}{"name":"Search","settings":[]}{% endschema %}
