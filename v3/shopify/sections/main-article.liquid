<article class="simple-page section-shell seo-editorial">
<nav class="seo-breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><a href="{{ blog.url }}">{{ blog.title | escape }}</a></nav>
<h1>{{ article.title | escape }}</h1>
<p>{% if article.author != blank %}{{ article.author | escape }} · {% endif %}<time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d %B %Y' }}</time></p>
{% assign article_image_alt = article.image.alt | default: article.title %}{% if article.image %}{{ article.image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '480, 800, 1100, 1400', sizes: '(min-width: 1000px) 900px, 90vw', alt: article_image_alt }}{% endif %}
<div class="rte">{{ article.content }}</div>
<a class="study-link" href="{{ blog.url }}">Back to {{ blog.title | escape }} ↗</a>
</article>
{% capture json_lt_escape %}{% raw %}\u003c{% endraw %}{% endcapture %}<script type="application/ld+json">{{ article | structured_data | replace: '<', json_lt_escape }}</script>
{% schema %}{"name":"Article","settings":[]}{% endschema %}
