<dialog class="cart-drawer" id="cart-drawer" aria-labelledby="cart-title"><div class="cart-drawer-head"><h2 id="cart-title">YOUR CART<span>.</span></h2><button type="button" data-cart-close aria-label="Close cart">Close ×</button></div><p data-cart-status role="status" aria-live="polite"></p><form action="{{ routes.cart_url }}" method="post" id="drawer-cart-form"><div data-cart-content>{% render 'cart-items' %}</div><div class="cart-drawer-bottom"><button type="submit" name="checkout" class="buy-button" data-checkout {% if cart.item_count == 0 %}hidden{% endif %}>Checkout <span aria-hidden="true">↗</span></button><a href="{{ routes.cart_url }}">View cart</a></div></form></dialog>
