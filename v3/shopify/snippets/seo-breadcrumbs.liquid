{% doc %}
  Uses canonical native URLs for product and collection breadcrumb markup.
{% enddoc %}
{%- if request.page_type == 'product' or request.page_type == 'collection' -%}
{%- capture json_lt_escape -%}{% raw %}\u003c{% endraw %}{%- endcapture -%}
{%- capture shop_url -%}{%- render 'absolute-url', url: routes.all_products_collection_url -%}{%- endcapture -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | json }}}{% if request.page_type == 'product' %},{"@type":"ListItem","position":2,"name":"Shop","item":{{ shop_url | json }}},{"@type":"ListItem","position":3,"name":{{ product.title | json | replace: '<', json_lt_escape }},"item":{{ canonical_url | json }}}{% else %},{"@type":"ListItem","position":2,"name":{{ collection.title | json | replace: '<', json_lt_escape }},"item":{{ canonical_url | json }}}{% endif %}]}
</script>
{%- endif -%}
