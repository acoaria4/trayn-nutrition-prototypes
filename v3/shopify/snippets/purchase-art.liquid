{% doc %}
  Presents the Belgian Chocolate flavour campaign artwork independently of the pouch.
  @param {string} [image_loading] - Eager for the product page, lazy below the home hero.
  @param {string} [image_priority] - High for the product page, auto below the hero.
{% enddoc %}
<figure class="purchase-art">
  <div class="purchase-art-stage">
    <img class="purchase-flavour-image" src="{{ 'belgian-chocolate-flavour-flow-1536.webp' | asset_url }}" srcset="{{ 'belgian-chocolate-flavour-flow-960.webp' | asset_url }} 960w, {{ 'belgian-chocolate-flavour-flow-1536.webp' | asset_url }} 1536w" sizes="(min-width: 900px) 84vw, 145vw" width="1536" height="1024" loading="{{ image_loading | default: 'lazy' }}" fetchpriority="{{ image_priority | default: 'auto' }}" decoding="async" alt="{{ 'products.flavour_image.alt' | t | escape }}">
  </div>
</figure>
