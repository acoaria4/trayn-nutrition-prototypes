{% doc %}
  Presents the Belgian Chocolate flavour campaign artwork independently of the pouch.
  @param {string} [image_loading] - Eager for the product page, lazy below the home hero.
  @param {string} [image_priority] - High for the product page, auto below the hero.
{% enddoc %}
<figure class="purchase-art">
  <div class="purchase-art-stage">
    <img class="purchase-flavour-image" src="{{ 'belgian-chocolate-flavour-1120.webp' | asset_url }}" srcset="{{ 'belgian-chocolate-flavour-640.webp' | asset_url }} 640w, {{ 'belgian-chocolate-flavour-1120.webp' | asset_url }} 1120w" sizes="(min-width: 900px) 45vw, 90vw" width="1120" height="1400" loading="{{ image_loading | default: 'lazy' }}" fetchpriority="{{ image_priority | default: 'auto' }}" decoding="async" alt="{{ 'products.flavour_image.alt' | t | escape }}">
  </div>
  <figcaption>{{ 'products.flavour_image.caption' | t }}</figcaption>
</figure>
