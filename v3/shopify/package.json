{
  "name": "trayn-shopify-theme",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "verify:baseline": "node scripts/verify-live-baseline.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/preview.mjs",
    "package": "node scripts/package.mjs",
    "theme:check": "shopify theme check",
    "theme:dev": "shopify theme dev --store trayn-nutrition.myshopify.com",
    "theme:push": "shopify theme push --unpublished --store trayn-nutrition.myshopify.com"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@shopify/cli": "^4.8.0",
    "esbuild": "^0.25.0",
    "liquidjs": "^10.21.1"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lenis": "1.3.26"
  }
}
