{
  "name": "trayn-after-dark",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/render-pages.mjs && vite --host 127.0.0.1",
    "build": "node scripts/render-pages.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:hosting": "node scripts/verify-hosting.mjs",
    "check": "node --check src/main.js && node --check src/motion.js && node --check scripts/render-pages.mjs"
  },
  "dependencies": {
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.55.0",
    "lighthouse": "^12.8.0",
    "prettier": "^3.9.9",
    "vite": "^7.1.0"
  }
}
