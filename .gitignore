# Dependencies, production output and local build caches.
node_modules/
/dist/
/.vite/
/.cache/
*.log

# Generated by scripts/render-pages.mjs; edit src/templates.js instead.
# Keep this exact list in sync with renderer outputs when adding a route.
/index.html
/product.html
/label-information.html
/404.html
/products/trayn-whey-rich-chocolate/index.html
/concepts/vanilla-creme/index.html
/concepts/cafe-mocha/index.html
