# Browser/test artifacts and local visual-review captures.
/test-results/
/playwright-report/
/playwright/.cache/
/coverage/
/docs/screenshots/
/docs/desktop-first.png
/docs/mobile-first.png

# Generated Lighthouse data, including archived runs; retain Markdown reports.
/docs/performance/**/*.html
/docs/performance/**/*.json

# Local environment, credentials and private signing material.
.env
.env.*
!.env.example
!.env.*.example
.envrc
.secrets/
*.pem
*.key
*.p12
*.pfx

# Python helper environments and caches.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Operating-system and editor state.
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/
.history/
*.swp
*.swo
*~
